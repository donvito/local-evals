{
  "datasetVersion": "synthetic-invoices-v2",
  "schemaVersion": "synthetic-invoice-schema-draft7-v2",
  "schemaPath": "schema.json",
  "outputMode": "prompted-json",
  "stagePrompts": {
    "ocr": "Transcribe every visible word, number, and table value from this invoice. Return plain text only.",
    "extraction": "Extract the invoice from the transcription into JSON. Preserve null and empty-string optional values exactly."
  },
  "ocrTarget": {
    "name": "local-vision-server",
    "baseUrl": "http://127.0.0.1:8080/v1",
    "model": "YOUR_VISION_MODEL_NAME",
    "supportsVision": true
  },
  "extractionTarget": {
    "name": "local-text-server",
    "baseUrl": "http://127.0.0.1:8081/v1",
    "model": "YOUR_TEXT_MODEL_NAME",
    "supportsStructuredOutput": false
  },
  "fieldRules": [
    { "path": "vendor", "match": "normalized" },
    { "path": "invoiceNumber", "match": "exact" },
    { "path": "date", "match": "date" },
    { "path": "billTo", "match": "exact" },
    { "path": "purchaseOrder", "match": "exact" },
    { "path": "lineItems", "match": "exact" },
    { "path": "subtotal", "match": "number", "tolerance": 0.01 },
    { "path": "tax", "match": "number", "tolerance": 0.01 },
    { "path": "total", "match": "number", "tolerance": 0.01 }
  ],
  "crossFieldRules": [
    { "name": "line item amounts equal subtotal", "type": "sum_equals", "fields": ["lineItems.0.amount", "lineItems.1.amount"], "total": "subtotal", "tolerance": 0.01 }
  ]
}
