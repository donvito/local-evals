  "extractionTarget": {
    "name": "local-mock-text-json",
    "baseUrl": "http://127.0.0.1:8099/v1",
    "model": "mock-text-json",
    "provider": "openai-compatible"
  },
  "fieldRules": [],
  "outputMode": "prompted-json",
  "schema": {
