      "attempts": { "type": "integer" },
      "note": { "type": ["string", "null"] },
      "annualLimit": { "type": "number" },
      "ratio": { "type": "number" },
      "count": { "type": "integer" },
      "unitPrice": { "type": "number" },
      "total": { "type": "number" },
      "comment": { "type": ["string", "null"] }
    }
  }
}
